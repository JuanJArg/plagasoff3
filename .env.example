# Copy this file to ".env" and fill in your real values. **Do not commit** the resulting
# .env file to source control; it contains secrets.
#
# Variables used by the Node/Next.js API (api/send-email.js)
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SENDER_EMAIL, TO_EMAIL
#
# Variables used by the PHP mail.php script (if you deploy PHP instead of Node):
#   SMTPJS_USER, SMTPJS_PASS, SMTPJS_TOKEN, SMTPJS_HOST, SMTPJS_PORT
#   (smtpjs_* variables are also populated from the plain SMTP_HOST/USER/PASS
#    for convenience.)
#
# Example values below:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=fumigadoraplagasoff@gmail.com
SMTP_PASS=your_app_password_here
SENDER_EMAIL=fumigadoraplagasoff@gmail.com   # optional, defaults to SMTP_USER
TO_EMAIL=fumigadoraplagasoff@gmail.com

# PHP-specific fallbacks (optional; if left blank the PHP script will use the
# SMTP_* values above):
#SMTPJS_HOST=
#SMTPJS_PORT=
#SMTPJS_USER=
#SMTPJS_PASS=
#SMTPJS_TOKEN=

# sample DMARC record for DNS (not actually used by code):
#v=DMARC1; p=quarantine; rua=mailto:fumigadoraplagasoff@gmail.com
